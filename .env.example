# Copy this file to .env and fill in your values. .env is gitignored.

# Your Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# PostgreSQL connection string. Local default after `createdb interview_prep`:
DATABASE_URL=postgresql://localhost:5432/interview_prep

# Optional: default model for new installs (switchable in Settings).
# MODEL_NAME=claude-opus-5

# Optional: where the web app listens.
# APP_HOST=127.0.0.1
# APP_PORT=8765

# --- Optional: question-bank scraper credentials ---
# Reddit app (script type, read-only): https://www.reddit.com/prefs/apps
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# GitHub token (no scopes; raises the rate limit): https://github.com/settings/tokens
# GITHUB_TOKEN=
