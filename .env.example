# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.

# Your Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# PostgreSQL connection string.
# Local default after `createdb interview_prep`:
DATABASE_URL=postgresql://localhost:5432/interview_prep

# Optional: override the default model (see config.py)
# MODEL_NAME=claude-sonnet-4-6

# Reddit API credentials for the question-bank scraper.
# Create an app at https://www.reddit.com/prefs/apps (script type, read-only).
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
# Optional: customize the user-agent string sent to Reddit.
# REDDIT_USER_AGENT=interview_mentor_scraper/1.0

# GitHub personal access token for the question-bank scraper.
# Create one at https://github.com/settings/tokens — no scopes needed (public repos only).
# Without this the GitHub scraper still works but is rate-limited to 60 req/hr.
GITHUB_TOKEN=your_github_token
